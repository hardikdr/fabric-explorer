{
  "name": "ironcore-fabric-explorer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests/e2e playwright.config.ts vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests/e2e playwright.config.ts vite.config.ts tsconfig.json package.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.1.12"
  }
}
